# Copy this file to .env and fill in real values. Never commit .env.

# Gemini API — used for the generation node in the LangGraph RAG flow
# (free tier, no payment method required — switched from Claude for that reason)
GEMINI_API_KEY=

# Voyage AI — used to embed document chunks at ingestion and queries at retrieval time
VOYAGE_API_KEY=

# Qdrant Cloud — vector store for embedded chunks
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=agile_ai_knowledge

# Comma-separated list of origins allowed to call this API (no wildcard in production)
# Local dev default: this project's Next.js dev server runs on port 3018,
# not Next's usual 3000 default -- see .claude/launch.json in the primary
# project directory (deliberately non-standard, to avoid colliding with
# other local projects' dev servers on this machine)
CORS_ORIGINS=http://localhost:3018

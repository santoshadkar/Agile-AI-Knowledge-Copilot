# Copy this file to .env and fill in real values. Never commit .env.

# Claude API — used for the generation node in the LangGraph RAG flow
ANTHROPIC_API_KEY=

# Voyage AI — used to embed document chunks at ingestion and queries at retrieval time
VOYAGE_API_KEY=

# Qdrant Cloud — vector store for embedded chunks
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=agile_ai_knowledge

# Comma-separated list of origins allowed to call this API (no wildcard in production)
# Local dev default: the Next.js dev server
CORS_ORIGINS=http://localhost:3000
